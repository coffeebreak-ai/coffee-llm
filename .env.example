# Скопируйте в .env. Файл .env не коммитится.
# Значения ключей подставьте сами. В примере их нет.

# Настройки процесса шлюза.
# DATA_PATH — журнал и изолированное техническое состояние диалогов, не база знаний.
GATEWAY_MODEL=Coffee LLM
# Эксперимент: 1 — весь ход выключен, запрос уходит в облачную модель как есть.
PROXY=0
PORT=8080
DATA_PATH=./data

# Помощник: local — локальная модель в Ollama, openai — Responses API.
OLLAMA_URL=http://127.0.0.1:11434
ASSISTANT_BACKEND=openai
ASSISTANT_MODEL=gpt-6-luna
ASSISTANT_LOCAL_MODEL=qwen3.5:9b
# Усилие помощника в облаке.
ASSISTANT_REASONING_EFFORT=medium

# Аджастер: local — модель в Ollama, jev — System One TypeSafe.
ADJUSTER_BACKEND=local
ADJUSTER_LOCAL_MODEL=nimble-v3:latest
JEV_BASE_URL=https://api.typesafe.ai
ADJUSTER_JEV_MODEL=jev-latest
JEV_API_KEY=
# Порог перехода 2→3 (эксперт с помощником → эксперт с MCP).
ADJUSTER_ESCALATION_CONFIDENCE=0.80

# Эксперт — основная облачная модель.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
EXPERT_MODEL=gpt-6.1-sol
EXPERT_REASONING_EFFORT=medium

# Длинный ответ помощника. По умолчанию те же адреса и модели, что у аджастера и ассистента.
# Отдельные значения нужны, когда эти роли переводятся на других агентов.
# DEFLATE_ADJASTOR_BASE_URL=
# DEFLATE_ADJASTOR_MODEL=
# DEFLATOR_BASE_URL=
# DEFLATOR_MODEL=

# Компактный старт эксперта: on — только новые диалоги. Старые продолжают полную историю.
COMPACT_EXPERT_CONTEXT=0
COMPACT_PACKET_CHAR_BUDGET=24000
COMPACT_EVIDENCE_CHAR_BUDGET=12000

# Замер двух ходов: on — только когда METRICS_REPOSITORY совпадает с последним коммитом.
METRICS_COMPARE=0
METRICS_REPOSITORY=
